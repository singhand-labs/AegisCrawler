# AegisCrawler Page Agent Service — example environment variables.
# Copy this file to .env and replace all placeholder values.

# Required security keys (server refuses to start when empty if REQUIRE_SECURITY_KEYS=true).
WORKER_API_KEY=change-me-worker-key-long-and-random
ADMIN_API_KEY=change-me-admin-key-long-and-random
VARIABLE_ENCRYPTION_KEY=change-me-encryption-key-at-least-32-characters-long

# Optional endpoint protection.
METRICS_API_KEY=change-me-metrics-key
SWAGGER_API_KEY=change-me-swagger-key

# Additive platform capabilities. Keep disabled until all participating
# extensions/workers are ready; clients can inspect GET /api/v1/capabilities.
FEATURE_RECORDING_V2=false
FEATURE_WORKFLOW_V2=false
FEATURE_WORKER_PROTOCOL_V2=false
FEATURE_MCP=false
MCP_RATE_LIMIT_PER_SECOND=10
MCP_RATE_LIMIT_BURST=20

# Recording v2 limits and encrypted-content retention.
RECORDING_MAX_DURATION=2h
RECORDING_MAX_ACTIONS=500
RECORDING_MAX_COMPRESSED_BYTES=26214400
RECORDING_RETENTION=168h

# LLM rule enhancement (optional).
# Set LLM_ENABLED=true and LLM_API_KEY to enable AI-enhanced rule generation.
LLM_ENABLED=false
# Compose requires an explicit policy mode. Keep legacy while LLM is disabled
# or for local migration. Production LLM traffic must use enforced with the
# complete route, pricing, hard-budget, and attempt-limit settings documented
# in docs/deployment.md.
LLM_POLICY_MODE=legacy
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT=60s
LLM_ENABLE_REFLECTION=true
LLM_CACHE_TTL=24h
