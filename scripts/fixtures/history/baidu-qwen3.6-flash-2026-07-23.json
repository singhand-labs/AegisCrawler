  "rule": {
    "id": "ext-1784777186792",
    "workspaceId": "",
    "version": "1.0.0",
    "name": "录制-百度一下，你就知道",
    "domain": "www.baidu.com",
    "urlPattern": {},
    "enabled": true,
    "priority": "",
    "entry": "https://www.baidu.com/",
    "variables": {
      "keyword": ""
    },
    "selectors": {
      "el1": {
        "role": "textbox",
        "selector": "#chat-textarea"
      },
      "el2": {
        "role": "button",
        "roleName": "百度一下",
        "selector": "#chat-submit-button",
        "text": "百度一下"
      }
    },
    "humanize": {
      "postDelay": [
        100,
        300
      ],
      "preDelay": [
        100,
        300
      ]
    },
    "steps": [
      {
        "action": "type",
        "target": {
          "$ref": "el1"
        },
        "value": "{{inputs.keyword}}"
      },
      {
        "action": "click",
        "target": {
          "$ref": "el2"
        }
      },
      {
        "action": "scrollBy",
        "direction": "down",
        "distance": 2,
        "unit": "pages"
      },
      {
        "action": "waitForElementVisible",
        "target": {
          "selector": "#content_left > .result",
          "visible": true
        }
      },
      {
        "action": "extract",
        "fields": {
          "summary": {
            "selector": ".c-row",
            "type": "text"
          },
          "title": {
            "selector": ".t",
            "type": "text"
          }
        },
        "multiple": true,
        "name": "items",
        "onEmpty": "fail",
        "target": {
          "selector": "#content_left > .result",
          "visible": true
        }
      },
      {
        "action": "loop",
        "as": "item",
        "items": "{{extracted.items}}",
        "steps": [
          {
            "action": "sendResult",
            "immediate": true,
            "payload": {
              "summary": "{{loopItem.summary}}",
              "title": "{{loopItem.title}}"
            }
          }
        ],
        "type": "forEach"
      }
    ],
    "output": {},
    "sendPolicy": {},
    "hooks": {
      "onError": [
        {
          "action": "saveSnapshot",
          "name": "errorSnapshot"
        },
        {
          "action": "flushResults"
        }
      ]
    },
