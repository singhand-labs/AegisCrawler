{
  "name": "aegiscrawler-rule-engine",
  "version": "0.2.0",
  "description": "AegisCrawler rule engine for human-like web automation",
  "license": "GPL-3.0-or-later",
  "author": "Singhand Labs <zy@singhand.com>",
  "homepage": "https://github.com/singhand-labs/AegisCrawler",
  "repository": {
    "type": "git",
    "url": "https://github.com/singhand-labs/AegisCrawler.git"
  },
  "bugs": {
    "url": "https://github.com/singhand-labs/AegisCrawler/issues",
    "email": "zy@singhand.com"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "generate-schema": "node scripts/generate-schema.js",
    "build": "tsc",
    "build:userscript": "node scripts/build-userscript.js",
    "build:extension": "node scripts/build-extension.js",
    "package:extension": "node scripts/package-extension.js",
    "build:admin": "node scripts/build-admin.js",
    "dev:admin": "cd admin-ui && npm run dev",
    "lint": "tsc --noEmit && cd admin-ui && npm run lint",
    "test": "vitest run && cd admin-ui && npm test",
    "test:coverage": "vitest run --coverage",
    "test:repository-integrity": "node --test scripts/repository-integrity.node-test.mjs",
    "generate-rule": "ts-node scripts/generate-rule.ts",
    "worker": "ts-node src/worker-host/cli.ts",
    "test:e2e": "ts-node scripts/e2e-deployment-test.ts",
    "test:e2e:browser": "npm run build:extension && npm run build:userscript && ts-node scripts/e2e-real-browser-test.ts",
    "test:e2e:staging": "npm run build:extension && ts-node scripts/e2e-staging-acceptance-test.ts",
    "test:e2e:replay": "npm run build:extension && ts-node scripts/e2e-replay-mv3-stability.ts && ts-node scripts/e2e-chunking-test.ts && ts-node scripts/e2e-worker-host-test.ts",
    "test:e2e:replay-mv3-stability": "npm run build:extension && ts-node scripts/e2e-replay-mv3-stability.ts",
    "test:e2e:replay-mv3-stability:qualification": "npm run build:extension && ts-node scripts/e2e-replay-mv3-stability.ts --qualification",
    "test:e2e:worker": "ts-node scripts/e2e-worker-host-test.ts",
    "test:e2e:chunking": "ts-node scripts/e2e-chunking-test.ts",
    "test:e2e:live-workflow": "npm run build:extension && ts-node scripts/live-workflow-test.ts",
    "test:e2e:mainstream-readonly": "ts-node scripts/mainstream-readonly-qualification.ts",
    "test:offline:bing-repeatability": "ts-node scripts/bing-workflow-offline-soak.ts",
    "test:e2e:books-generation": "ts-node scripts/live-workflow/books-generation-canary.ts",
    "test:e2e:baidu-replay": "ts-node scripts/baidu-provider-free-replay.ts",
    "test:e2e:production": "node scripts/e2e-production-readiness-test.js",
    "test:external:contract": "node --test scripts/external-production-qualification.contract.js",
    "test:e2e:live-llm-local": "ts-node scripts/local-live-llm-canary.ts",
    "test:e2e:external": "node scripts/external-production-qualification.js",
    "test:e2e:manual": "echo 'Manual-only E2E scripts (not wired to CI; 7 total post-D-1 — see docs/superpowers/specs/2026-08-03-recording-replay-robustness-design.md §2.1 Step 2(c) and S-2): replay-mv3-stability:qualification, live-workflow, mainstream-readonly, baidu-replay, books-generation, live-llm-local, external.'"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "adm-zip": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^5.2.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "typescript-json-schema": "^0.68.0",
    "vitest": "^4.1.9"
  }
}
